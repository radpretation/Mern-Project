# =============================================================================
# Panacea Compliance System - Frontend Environment Configuration
# =============================================================================

# In development (with Vite proxy) or unified reverse-proxy deployments (e.g. Nginx):
# Leave as /api or empty to use relative routing.
VITE_API_URL=/api

# For cross-domain deployments (e.g. Frontend on Vercel/Netlify and Backend on an EC2/Cloud server):
# Set this to your production backend API origin + prefix:
# VITE_API_URL=https://api.yourdomain.com/api
