# =============================================================================
# Panacea Compliance System - Backend Environment Configuration
# =============================================================================

# Server Port & Runtime Environment
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB URI)
MONGODB_URI=mongodb://localhost:27017/panaceainfosec

# Authentication & JWT Secrets (Change these in production!)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here
REFRESH_TOKEN_EXPIRES_IN=30d

# Administrator Email (for notifications & system alerts)
ADMIN_EMAIL=admin@yourdomain.com

# SMTP Email Configuration (for reset password & welcome emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Allowed CORS Origins (Supports single domain, comma-separated domains, or * for all)
# e.g.: CORS_ORIGIN=https://compliance.yourdomain.com,https://admin.yourdomain.com
CORS_ORIGIN=http://localhost:5173

# Uploads directory
UPLOAD_DIR=./uploads
